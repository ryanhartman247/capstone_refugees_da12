    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='keys'>
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98214' id='3' type-v2='text' w='47278' x='468' y='893'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='16'>Key Takeaways: </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='16'>- Large increases in refugees typically coincide with wars, but not always (El Salvador) </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='16'>- Refugees typically flee to neighboring countries (except for the US)</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='16'>- A country’s population typically declines as refugees increase </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#efebe8' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='98214' id='5' type-v2='text' w='51786' x='47746' y='893'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='16'>Further Analysis:</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='16'>- How is GDP affected after refugees flee from a country? How many years into the future is that affected? </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='16'>- Do refugees return after wars end? How long does it take for population numbers to return? </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='16'>- How long after wars end does it take for refugees to return? Is there a correlation between </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='16'>- Could rises in refugees predict wars? </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#e6ecf0' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
