              </zone-style>
            </zone>
            <zone h='93552' id='17' param='vert' removable='false' type-v2='layout-flow' w='99064' x='468' y='5543'>
              <zone h='93552' id='1' param='vert' removable='false' type-v2='layout-flow' w='99064' x='468' y='5543'>
                <zone fixed-size='121' h='13688' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99064' x='468' y='5543' />
                <zone h='79864' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99064' x='468' y='19231'>
                  <flipboard active-id='27' nav-type='caption' show-nav-arrows='true'>
                    <story-points>
                      <story-point caption='Cover' captured-sheet='' id='5' />
                      <story-point caption='Introduction and Overview' captured-sheet='' id='7' />
                      <story-point caption='Methodology and Limitations' captured-sheet='' id='12' />
                      <story-point caption='Origin: &#10;Countries Map' captured-sheet='Origin Dash' id='11'>
                        <capturedDeltas>
                          <worksheet name='Origin'>
                            <style delta-type='added'>
                              <style-rule element='axis'>
                                <encoding attr='space' class='0' field='[federated.1px3ihv06pyqq712foy4g1oaugma].[Latitude (generated)]' field-type='quantitative' max='13253817.081449255' min='-9088972.0079275295' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                                <encoding attr='space' class='0' field='[federated.1px3ihv06pyqq712foy4g1oaugma].[Longitude (generated)]' field-type='quantitative' max='26847490.815523189' min='-25997758.811263531' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                              </style-rule>
                            </style>
                          </worksheet>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Origin: &#10;Countries by Year' captured-sheet='pivot origin all' id='15' />
                      <story-point caption='Origin: &#10;Focus Countries' captured-sheet='pivot origin 4' id='16' />
                      <story-point caption='Origin: &#10;Afghan Refugees&apos; Country of Asylum' captured-sheet='Afghan Dash' id='13'>
                        <capturedDeltas>
                          <worksheet name='Afghan'>
                            <style delta-type='added'>
                              <style-rule element='axis'>
                                <format attr='title' class='0' field='[federated.1px3ihv06pyqq712foy4g1oaugma].[sum:Population (afghan.csv):qk]' scope='rows' value='Population' />
                              </style-rule>
                            </style>
                          </worksheet>
                          <dashboard name='Afghan Dash'>
                            <zone id='219'>
                              <formatted-text>
                                <run fontcolor='#000000' fontname='Arial' fontsize='14'>- Afghanistan is responsible for the most refugees of any country ever</run>
                                <run>Æ&#10;&#10;</run>
                                <run fontcolor='#000000' fontname='Arial' fontsize='14'>- Afghanistan has been plagued by wars ever since UN has collected data</run>
                                <run>Æ&#10;&#10;</run>
                                <run fontcolor='#000000' fontname='Arial' fontsize='14'>- In 1990, while the population was around 10 million, there were over 6 million Afghan refugees (60% of the population). </run>
                                <run>Æ&#10;&#10;</run>
                                <run fontcolor='#000000' fontname='Arial' fontsize='14'>- Pakistan and Iran (both bordering countries) have provided asylum to the majority of Afghan refugees for several years</run>
                              </formatted-text>
                            </zone>
                          </dashboard>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Origin:&#10;Salvadorian Refugees&apos; Country of Asylum' captured-sheet='salvador dash' id='17'>
                        <capturedDeltas>
                          <dashboard name='salvador dash'>
                            <zone id='19'>
                              <formatted-text>
                                <run fontcolor='#202122' fontname='Arial' fontsize='12'>The UN reports that the war killed more than 75,000 people between 1979 and 1992, along with approximately 8,000 disappeared persons. Human rights violations, particularly the kidnapping, torture, and murder of suspected FMLN sympathizers by state security forces and paramilitary death squads – were pervasive.</run>
                                <run>Æ&#10;</run>
                                <run fontcolor='#0000ff' fontname='Benton Sans Book' fontsize='12' underline='true'>Source</run>
                                <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
                              </formatted-text>
                            </zone>
                            <zone id='88'>
                              <formatted-text>
                                <run fontalignment='1'>Æ&#10;</run>
                                <run fontalignment='1' fontsize='18'>Salvadoran Civil War </run>
                                <run fontalignment='1'>Æ&#10;</run>
                                <run fontalignment='1' fontsize='18'>(1979 - 1992)</run>
                                <run fontalignment='1'>Æ




































</run>
                              </formatted-text>
                            </zone>
                          </dashboard>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Origin:&#10;Syrian Refugees&apos; Country of Asylum' captured-sheet='syria dash' id='18' />
                      <story-point caption='Origin: &#10;Ukrainian Refugees&apos; Country of Asylum' captured-sheet='ukraine dash' id='19'>
                        <capturedDeltas>
                          <worksheet name='Ukraine'>
                            <selection-collection />
                          </worksheet>
                          <dashboard name='ukraine dash'>
                            <zone id='10'>
                              <formatted-text>
                                <run fontcolor='#202122' fontname='sans-serif' fontsize='12'>In March and April 2021, prior to the 2022 </run>
                                <run fontcolor='#000000' fontname='sans-serif' fontsize='12'>Russian invasion of Ukraine</run>
                                <run fontcolor='#202122' fontname='sans-serif' fontsize='12'>, the </run>
                                <run fontcolor='#000000' fontname='sans-serif' fontsize='12'>Russian Armed Forces</run>
                                <run fontcolor='#202122' fontname='sans-serif' fontsize='12'> began massing thousands of personnel and military equipment near </run>
                                <run fontcolor='#000000' fontname='sans-serif' fontsize='12'>Russia&apos;s border with Ukraine</run>
                                <run fontcolor='#202122' fontname='sans-serif' fontsize='12'> and in </run>
                                <run fontcolor='#000000' fontname='sans-serif' fontsize='12'>Crimea</run>
                              </formatted-text>
                            </zone>
                          </dashboard>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Asylum: &#10;Countries Map' captured-sheet='Asylum Dash' id='10'>
                        <capturedDeltas>
                          <worksheet name='Asylum'>
                            <style delta-type='added'>
                              <style-rule element='axis'>
                                <encoding attr='space' class='0' field='[federated.1px3ihv06pyqq712foy4g1oaugma].[Latitude (generated)]' field-type='quantitative' max='12180811.419276474' min='-3505804.3916444387' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                                <encoding attr='space' class='0' field='[federated.1px3ihv06pyqq712foy4g1oaugma].[Longitude (generated)]' field-type='quantitative' max='18907190.860767409' min='-18121089.244554766' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                              </style-rule>
                            </style>
                          </worksheet>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Asylum: &#10;Countries by Year' captured-sheet='asylum dash' id='20' />
                      <story-point caption='Asylum:&#10;USA by Year' captured-sheet='usa dash' id='28' />
                      <story-point caption='Asylum:&#10;USA (map)' captured-sheet='usa2 dash' id='29'>
                        <capturedDeltas>
                          <worksheet name='usa2'>
                            <style delta-type='added'>
                              <style-rule element='axis'>
                                <encoding attr='space' class='0' field='[federated.1px3ihv06pyqq712foy4g1oaugma].[Latitude (generated)]' field-type='quantitative' max='13607838.514324896' min='-4308374.475531064' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                                <encoding attr='space' class='0' field='[federated.1px3ihv06pyqq712foy4g1oaugma].[Longitude (generated)]' field-type='quantitative' max='22139331.322972719' min='-20208080.739577278' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                              </style-rule>
                            </style>
                          </worksheet>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Correlation &#10;(origin vs asylum)' captured-sheet='corr dash' id='23' />
                      <story-point caption='Key Takaways' captured-sheet='keys' id='30'>
                        <capturedDeltas>
                          <dashboard name='keys'>
                            <zone id='3'>
                              <formatted-text>
                                <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='16'>Key Takeaways: </run>
                                <run>Æ&#10;&#10;</run>
                                <run fontcolor='#000000' fontname='Arial' fontsize='16'>- Large increases in refugees typically coincide with wars, but not always (El Salvador) </run>
                                <run>Æ&#10;&#10;</run>
                                <run fontcolor='#000000' fontname='Arial' fontsize='16'>- Refugees typically flee to neighboring/bordering countries (except for the US)</run>
                                <run>Æ&#10;&#10;</run>
                                <run fontcolor='#000000' fontname='Arial' fontsize='16'>- A country’s population typically declines as refugees increase </run>
                              </formatted-text>
                            </zone>
                          </dashboard>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='The End' captured-sheet='' id='27' />
